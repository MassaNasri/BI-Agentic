# Copy this file to .env and replace every CHANGE_ME/replace-with value.
# Docker Compose automatically loads the resulting local .env file.

# Core database configuration
DB_NAME=bi_voice_agent
DB_USER=bi_admin
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_HOST=host.docker.internal
DB_PORT=5432

# Django/runtime security
APP_ENV=development
PAYMENT_MODE=disabled
DJANGO_SECRET_KEY=CHANGE_ME_DJANGO_SECRET_KEY
ETL_DJANGO_SECRET_KEY=CHANGE_ME_ETL_DJANGO_SECRET_KEY
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,api-gateway,auth-service,workspace-service,report-service,voice-service,ai-service,query-service,visualization-service,subscription-service,notification-service
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email/admin bootstrap
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=CHANGE_ME_EMAIL_HOST_PASSWORD
DEFAULT_FROM_EMAIL=BI Voice Agent <no-reply@example.com>
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_NAME=System Admin
SYSTEM_ADMIN_USER_ID=0

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=etl
CLICKHOUSE_USER=replace-with-clickhouse-user
CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE_PASSWORD

# SurrealDB / ETL metadata
SURREAL_USER=replace-with-surreal-user
SURREAL_PASS=CHANGE_ME_SURREAL_PASS

# Metabase
METABASE_URL=http://metabase:3000
METABASE_EMBED_URL=http://localhost:3000
METABASE_APP_DB_PASSWORD=CHANGE_ME_METABASE_APP_DB_PASSWORD
METABASE_ENCRYPTION_SECRET_KEY=CHANGE_ME_METABASE_ENCRYPTION_SECRET_KEY
METABASE_AUTH_TYPE=session
METABASE_USERNAME=metabase-admin@example.com
METABASE_PASSWORD=CHANGE_ME_METABASE_PASSWORD
METABASE_DATABASE_ID=2
METABASE_SECRET_KEY=CHANGE_ME_METABASE_SECRET_KEY

# Service URLs
AUTH_SERVICE_URL=http://auth-service:8001
WORKSPACE_SERVICE_URL=http://workspace-service:8002
REPORT_SERVICE_URL=http://report-service:8003
VOICE_SERVICE_URL=http://voice-service:8004
AI_SERVICE_URL=http://ai-service:8005
QUERY_SERVICE_URL=http://query-service:8006
QUERY_MAX_EXECUTION_SECONDS=30
QUERY_MAX_ROWS=10000
QUERY_MAX_RESULT_BYTES=5242880
QUERY_MAX_BYTES_TO_READ=1073741824
QUERY_MAX_MEMORY_USAGE=536870912
QUERY_WORKSPACE_CONCURRENCY=2
QUERY_PAGE_SIZE=500
QUERY_MAX_PAGE_SIZE=1000
ETL_PROCESSING_TIMEOUT_SECONDS=240
VISUALIZATION_SERVICE_URL=http://visualization-service:8007
SUBSCRIPTION_SERVICE_URL=http://subscription-service:8008
NOTIFICATION_SERVICE_URL=http://notification-service:8010

# Internal service credentials
INTERNAL_SERVICE_TOKEN=CHANGE_ME_INTERNAL_SERVICE_TOKEN
NOTIFICATION_SERVICE_API_KEY=CHANGE_ME_NOTIFICATION_SERVICE_API_KEY
AI_SERVICE_INTERNAL_API_KEY=CHANGE_ME_AI_SERVICE_INTERNAL_API_KEY
AI_SERVICE_REQUIRE_INTERNAL_AUTH=true
ETL_INTERNAL_API_KEY=CHANGE_ME_ETL_INTERNAL_API_KEY
INGESTION_CALLBACK_API_KEY=CHANGE_ME_INGESTION_CALLBACK_API_KEY
CREDENTIAL_SECRET_KEY=CHANGE_ME_CREDENTIAL_SECRET_KEY
ETL_APPROVED_DESTINATION_CIDRS=
# Comma-separated CIDRs for explicitly approved private database destinations.
# Resolve host.docker.internal inside etl-connector/etl-extractor and use the
# exact address as a /32 for local host-database acceptance. Never use 0.0.0.0/0.
# Example for an isolated disposable Docker test network only: 172.20.0.0/16
ETL_SQLITE_MAX_BYTES=1073741824

# Operational limits
GATEWAY_RATE_LIMIT_REQUESTS=120
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=6
GATEWAY_UPSTREAM_TIMEOUT_SECONDS=360
FREE_TIER_VOICE_REQUEST_LIMIT=3
SUBSCRIPTION_EXPIRY_WARNING_DAYS=7,3,1
NOTIFICATION_EXPIRY_CHECK_INTERVAL_SECONDS=21600
PASSWORD_RESET_CODE_EXPIRY_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

# Voice/Whisper
SMALL_WHISPER_HEALTH_TIMEOUT_SECONDS=5
SMALL_WHISPER_CONNECT_TIMEOUT_SECONDS=10
SMALL_WHISPER_TIMEOUT_SECONDS=300
SMALL_WHISPER_MAX_RETRIES=1
SMALL_WHISPER_URL=http://ai-service:8005
WHISPER_MODEL_NAME=small
WHISPER_CACHE_DIR=/root/.cache/whisper
WHISPER_TASK=transcribe
TRANSCRIPTION_REDIS_URL=redis://redis:6379/0

# LLM provider
OPENROUTER_API_KEY=CHANGE_ME_OPENROUTER_API_KEY
OPENROUTER_MODEL=google/gemma-3n-e4b-it:free

# TimesFM forecasting (Docker-mounted local model)
TIMESFM_MODEL_DIR=/models/timesfm
TIMESFM_DEFAULT_HORIZON=12
TIMESFM_MIN_POINTS=8
TIMESFM_MAX_CONTEXT=1024
TIMESFM_MAX_HORIZON=256
TIMESFM_DEVICE=cpu
TIMESFM_DTYPE=float32
TIMESFM_ENABLE_QUANTILES=true
TIMESFM_MODEL_ID=google/timesfm-2.5-200m-pytorch

# Dagster forecasting handler wiring
INTENT_EXTRACTION_FORECASTING_HANDLER_PATH=forecasting.dagster_handler:run_forecasting_handler

# Ollama on the Docker host
VISUALIZATION_CHART_SELECTOR_OLLAMA_URL=http://host.docker.internal:11434/api/generate
VISUALIZATION_CHART_SELECTOR_OLLAMA_MODEL=gemma3:1b
SQL_REVIEW_OLLAMA_URL=http://host.docker.internal:11434/api/generate
SQL_REVIEW_OLLAMA_MODEL=gemma3:1b
INTENT_CLASSIFIER_OLLAMA_URL=http://host.docker.internal:11434/api/generate
INTENT_CLASSIFIER_OLLAMA_MODEL=gemma3:1b
TEXT_PREPROCESS_OLLAMA_URL=http://host.docker.internal:11434/api/generate
TEXT_PREPROCESS_MODEL=gemma3:1b
PREPROCESS_HIGH_OLLAMA_URL=http://host.docker.internal:11434/api/generate
PREPROCESS_HIGH_OLLAMA_MODEL=gemma3:1b
INTENT_EXTRACTION_OLLAMA_URL=http://host.docker.internal:11434/api/generate
INTENT_EXTRACTION_OLLAMA_MODEL=gemma3:1b
